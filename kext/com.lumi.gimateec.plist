<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lumi.gimateec</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/bin/kmutil showloaded --list-only | /usr/bin/grep -q com.lumi.GiMATEEC || /usr/bin/kmutil load -p /Library/Extensions/GiMATEEC.kext</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LaunchOnlyOnce</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/gimateec.err</string>
	<key>StandardOutPath</key>
	<string>/var/log/gimateec.out</string>
</dict>
</plist>
